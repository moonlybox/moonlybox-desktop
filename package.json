{
  "name": "moonlybox-desktop",
  "version": "0.1.0",
  "description": "MoonlyBox desktop client — CLI first (M1): login / sync / inbox / xiaoyue",
  "type": "module",
  "bin": {
    "moonlybox": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/moonlybox",
    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "^1.1.0"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0"
  }
}
